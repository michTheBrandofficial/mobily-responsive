{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"build": {
		"beforeBuildCommand": "pnpm run build",
		"beforeDevCommand": "pnpm run dev",
		"devUrl": "http://localhost:1420",
		"frontendDist": "../dist"
	},
	"productName": "Mobily Responsive (Beta)",
	"version": "../package.json",
	"app": {
		"security": {
			"csp": null
		},
		"windows": [
			{
				"label": "main",
				"visible": false,
				"fullscreen": false,
				"height": 1080,
				"resizable": true,
				"title": "Simulator",
				"transparent": true,
				"decorations": false,
				"shadow": false,
				"center": false
			}
		]
	},
	"plugins": {
		"updater": {
			"active": true,
			"endpoints": [
				"https://github.com/michthebrandofficial/mobily-responsive/releases/latest/download/latest.json"
			],
			"dialog": true,
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYyRjM4NEI0Q0Y4MTM0MzIKUldReU5JSFB0SVR6OG90VmxwNDZpNnhLYlhYdCtPQ1ZOR0R4aFNFbVg5NFFDNWtIUmhZK2V2ei8K"
		}
	},
	"identifier": "com.mobily-responsive.dev",
	"bundle": {
		"active": true,
		"category": "DeveloperTool",
		"copyright": "",
		"externalBin": [],
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"longDescription": "A desktop application that helps developers test their websites across different device sizes and resolutions. Built with Tauri and React for optimal performance and native integration.",
		"resources": [],
		"shortDescription": "A desktop app for testing website responsiveness across different device sizes",
		"targets": "all",
		"windows": {
			"certificateThumbprint": null,
			"digestAlgorithm": "sha256",
			"timestampUrl": ""
